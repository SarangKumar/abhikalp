# Copy to .env.local and fill in. Never commit real values.

# --- App -------------------------------------------------------------------
# Public base URL (used for metadata, Stripe redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional branding overrides (defaults live in src/config/site.ts)
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT_NAME=
# GitHub repository name (owner SarangKumar) for navbar stars/links
NEXT_PUBLIC_GITHUB_REPO=

# --- Database (MongoDB, must be a replica set for Prisma) -------------------
# Must include the database name (e.g. /abhikalp) before the "?"
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/abhikalp?retryWrites=true&w=majority"

# --- Auth (next-auth v4) ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# bcrypt cost for email/password sign-up (default 10)
SALT_ROUNDS=10
# OAuth providers are enabled only when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Stripe (subscriptions) ---------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/v1/webhook` locally,
# or the webhook endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring Price IDs for each paid plan.
STRIPE_PRICE_GOLD=price_xxx
STRIPE_PRICE_PLATINUM=price_xxx

# --- AI assistant (NOT USED YET) ------------------------------------------
# The AI assistant is switched off (src/config/features.ts). Leave these empty;
# they only matter once features.aiAssistant is set to true.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Optional: force one model for all plans (default per plan in src/config/subscription.ts)
AI_MODEL=

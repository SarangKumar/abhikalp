generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  COLLABORATOR
  VIEWER
  ADMIN
}

enum SubscriptionTier {
  FREE
  GOLD
  PLATINUM
}

model User {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  email         String           @unique
  name          String
  /// Null for OAuth-only accounts.
  password      String?
  image         String?
  projects      Project[]
  memberships   ProjectMember[]
  invitesSent   ProjectInvite[]  @relation("InvitedBy")
  assignedTasks Task[]           @relation("TaskAssignee")
  taskComments  TaskComment[]
  activities    ActivityLog[]
  subscription  SubscriptionTier @default(FREE)
  isVerified    Boolean          @default(false)

  // Stripe billing state, written only by the webhook (src/lib/billing.ts).
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeStatus            String?
  stripeCurrentPeriodEnd  DateTime?
  stripeCancelAtPeriodEnd Boolean   @default(false)

  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  isFavourite Boolean @default(false)
  isPrivate   Boolean @default(true)
  githubUrl   String?
  deployedUrl String?

  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id])

  tasks      Task[]
  members    ProjectMember[]
  invites    ProjectInvite[]
  references Reference[]
  whiteboard Whiteboard?
  milestones Milestone[]
  activities ActivityLog[]

  /// Planning: lifecycle status, health and schedule.
  status     ProjectStatus? @default(ACTIVE)
  health     ProjectHealth? @default(ON_TRACK)
  startDate  DateTime?
  targetDate DateTime?

  /// Markdown project documentation (Documentation tab).
  docs String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Task {
  id                         String          @id @default(auto()) @map("_id") @db.ObjectId
  title                      String
  description                String?
  status                     TaskStatus
  estimatedTimeForCompletion Int?
  priority                   TaskPriority    @default(MEDIUM)
  dueDate                    DateTime?
  /// Position within its status column (board order). Null = legacy, sorts by createdAt.
  order                      Int?
  startDate                  DateTime?
  /// Set when the task moves to COMPLETED (burndown / progress).
  completedAt                DateTime?
  labels                     String[]
  checklist                  ChecklistItem[]

  assigneeId  String?       @db.ObjectId
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  milestoneId String?       @db.ObjectId
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  comments    TaskComment[]

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// A user who can access a project they do not own.
/// Roles: ADMIN (manage members + edit), COLLABORATOR (edit), VIEWER (read).
/// The owner is Project.owner and is never stored here.
model ProjectMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      Role     @default(COLLABORATOR)
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// Invite by email. Accepted from the dashboard (matching email) or via the
/// shareable /invite/<token> link while it has not expired.
model ProjectInvite {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  role        Role      @default(COLLABORATOR)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  projectId   String    @db.ObjectId
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String    @db.ObjectId
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@index([email])
}

/// A scraped web page saved as reference material for a project.
model Reference {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  title     String
  content   String
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Excalidraw scene for a project's Playground (one per project).
model Whiteboard {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @unique @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// { elements, files, appState: { viewBackgroundColor } }
  scene       Json
  updatedById String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

/// Subtask / checklist entry embedded in a task.
type ChecklistItem {
  id   String
  text String
  done Boolean @default(false)
}

/// A dated goal; progress is derived from its linked tasks.
model Milestone {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String    @db.ObjectId
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model TaskComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  body      String
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

/// Append-only project activity feed.
model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?  @db.ObjectId
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// e.g. task.created, task.moved, milestone.updated, project.updated
  action    String
  summary   String
  entityId  String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
